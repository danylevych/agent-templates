{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coworker/agent-templates/template.schema.json",
  "title": "Agent template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "description", "status"],
  "properties": {
    "id": {
      "description": "Stable key. Must equal the template's directory name.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": {
      "description": "One of the ids in categories.yaml.",
      "type": "string"
    },
    "icon": {
      "description": "A built-in icon name. An icon.svg next to template.yaml takes precedence.",
      "type": "string"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "useCases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 8
    },
    "status": { "enum": ["draft", "published"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "description": "Model name or alias as obot knows it. The member can pick another one.",
          "type": "string"
        }
      }
    },
    "apps": {
      "description": "MCP servers, by catalog entryKey, with the tools the agent may use.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "tools"],
        "properties": {
          "key": {
            "description": "The MCP catalog entry's entryKey. No repository URL.",
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "tools": {
            "description": "Tool names. An empty list means none; list them explicitly.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "skills": {
      "description": "Skills obot already has, by their SKILL.md name. No repository URL; templates never ship skills.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
      "uniqueItems": true
    }
  }
}
